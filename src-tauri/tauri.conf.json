{
  "$schema": "https://schema.tauri.app/config/2.0.0-dev",
  "productName": "Rocktier Journal",
  "version": "0.1.1",
  "identifier": "com.rocktier.journal",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rocktier Journal",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": false,
      "freezePrototype": false,
      "pattern": {
        "use": "brownfield"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "category": "lifestyle",
    "copyright": "Copyright \u00a9 2026 Rocktier",
    "externalBin": [],
    "longDescription": "Rocktier Journal \u2014 a private diary. Encrypted. Offline. Yours alone.",
    "shortDescription": "Private encrypted diary",
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "exceptionDomain": "",
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": null
    },
    "resources": [],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": null
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "iOS": {},
    "android": {}
  }
}
